# ── CampusCafe API — Environment ────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# PostgreSQL connection string
# Local (docker-compose): host is the compose service name "postgres"
DATABASE_URL="postgresql://campuscafe:campuscafe@localhost:5432/campuscafe?schema=public"

# JWT signing secret — generate a long random value in production
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# HTTP
PORT=3000
NODE_ENV=development

# CORS — comma-separated origins, or * for all (dev only)
CORS_ORIGIN=*

# Rate limit (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
