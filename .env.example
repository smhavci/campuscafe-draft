# CampusCafe — root env for docker-compose (optional; sensible defaults exist).
# Copy to .env to override. Do NOT commit .env.

# Postgres
POSTGRES_USER=campuscafe
POSTGRES_PASSWORD=campuscafe
POSTGRES_DB=campuscafe
POSTGRES_PORT=5432

# API
API_PORT=3000
JWT_SECRET=dev-secret-change-me-in-production-please
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
